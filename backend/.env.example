# Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL for cloud/production deployment, or SQLite for local container/dev)
# PostgreSQL Example: DATABASE_URL="postgresql://postgres:password@postgres:5432/office_expanse?schema=public"
# SQLite Example: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/office_expanse"

# JWT Secrets (REQUIRED: Change to strong 32+ char random keys in production)
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Frontend URLs (Comma separated for multiple domains)
FRONTEND_URL=https://app.yourdomain.com,http://localhost:5173

# Cookie Security (lax for same-domain, none for cross-domain HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# Serve Frontend static assets from backend (set true for unified deployment)
SERVE_FRONTEND=false

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# SMTP Email Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@company.com
